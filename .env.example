# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Local dev: `npm run db:start` launches PostgreSQL on port 54329 (no Docker needed).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/tapdiq?schema=public"

# Public base URL of the app (used for origin checks on uploads).
APP_URL="http://localhost:3000"

# ── File storage ───────────────────────────────────────────────────────
# "local"    -> files on disk in STORAGE_LOCAL_DIR (default ./storage/uploads)
# "supabase" -> Supabase Storage (private bucket). Adapter is written but UNTESTED without credentials.
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="./storage/uploads"
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="order-media"

# ── Seed (demo accounts created by `npm run db:seed`) ──────────────────
# Change these before seeding anything that is reachable from the internet.
SEED_ADMIN_EMAIL="admin@tapdiq.az"
SEED_ADMIN_PASSWORD="Admin-demo-2026"
SEED_CUSTOMER_EMAIL="leyla@example.com"
SEED_CUSTOMER_PASSWORD="Customer-demo-2026"
