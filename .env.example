# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Local dev: `npm run db:start` launches PostgreSQL on port 54329 (no Docker needed).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/tapdiq?schema=public"

# Public base URL of the app (used for origin checks on uploads).
APP_URL="http://localhost:3000"

# ── File storage ───────────────────────────────────────────────────────
# "local"    -> files on disk in STORAGE_LOCAL_DIR (default ./storage/uploads)
# "supabase" -> Supabase Storage (private bucket). Adapter is written but UNTESTED without credentials.
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="./storage/uploads"
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="order-media"

# ── Seed (demo accounts created by `npm run db:seed`) ──────────────────
# Change these before seeding anything that is reachable from the internet.
SEED_ADMIN_EMAIL="admin@tapdin.az"
SEED_ADMIN_PASSWORD="Admin-demo-2026"
SEED_CUSTOMER_EMAIL="leyla@example.com"
SEED_CUSTOMER_PASSWORD="Customer-demo-2026"

# ── Customer notifications ─────────────────────────────────────────────
# Email over SMTP (any provider). Without SMTP_HOST, in development, emails are written to storage/outbox/*.html.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Tapdın <no-reply@tapdin.az>"
# WhatsApp Cloud API (Meta). Requires approved templates: tapdin_quote_ready, tapdin_payment_confirmed, tapdin_order_status
# (body parameters {{1}} name, {{2}} order number, {{3}} amount or status), each in az / ru / en.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Daily job (/api/cron/daily): CBAR exchange rates + customer reminders. Call once a day from cron with
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://tapdin.az/api/cron/daily
CRON_SECRET=""
