generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users & auth ─────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AccountType {
  PERSONAL
  BUSINESS
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         Role        @default(CUSTOMER)
  accountType  AccountType @default(PERSONAL)
  locale       String      @default("az")
  /// Order updates by email (on by default) and WhatsApp (explicit opt-in only).
  notifyEmail    Boolean   @default(true)
  notifyWhatsApp Boolean   @default(false)
  adminNotes   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions        Session[]
  orders          Order[]
  businessProfile BusinessProfile?
  internalNotes   InternalNote[]
  events          OrderEvent[]
  notifications   Notification[]
  passwordResets  PasswordReset[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Future-ready B2B module: business accounts get their own commission rate
/// and are quoted as properly declared commercial imports (never split across individuals).
model BusinessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  taxId             String?
  commissionPercent Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
}

// ───────────────────────── Catalogue of sources ─────────────────────────

/// Whether customers can order from a region. COMING_SOON regions stay visible as announced directions,
/// but the API refuses orders and staff cannot send quotations for them.
enum RegionStatus {
  ACTIVE
  COMING_SOON
}

/// Pricing rules differ per sourcing region (China / Russia / USA / Europe ...).
model Region {
  key                  String   @id
  name                 String
  enabled              Boolean  @default(true)
  /// Single source of truth for availability, read by the site, the order API and the admin.
  status               RegionStatus @default(ACTIVE)
  defaultCurrency      String
  commissionPercent    Decimal  @db.Decimal(5, 2)
  minCommissionAzn     Decimal  @db.Decimal(10, 2)
  cargoPerKgUsd        Decimal  @db.Decimal(10, 2)
  minBillableWeightKg  Decimal  @db.Decimal(6, 2)
  /// Free-text guidance for staff. Customs rules must be verified against current regulations.
  customsNote          String?
  sortOrder            Int      @default(0)
  updatedAt            DateTime @updatedAt

  marketplaces Marketplace[]
}

model Marketplace {
  key          String   @id
  name         String
  regionKey    String
  region       Region   @relation(fields: [regionKey], references: [key])
  /// Hostname suffixes used for detection, e.g. ["taobao.com", "tmall.com"]
  hostPatterns String[]
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
}

model ExchangeRate {
  currency  String   @id
  rateToAzn Decimal  @db.Decimal(12, 6)
  /// CBAR = official rate of the Central Bank of Azerbaijan; MANUAL = typed in Settings.
  source    String   @default("MANUAL")
  updatedAt DateTime @updatedAt
}

/// Admin-configurable order statuses. `key` is stable; labels and order are editable.
model OrderStatus {
  key             String  @id
  labelAz         String
  labelRu         String
  labelEn         String
  sortOrder       Int
  active          Boolean @default(true)
  /// System statuses drive business logic (quotes, payments) and cannot be removed.
  isSystem        Boolean @default(false)
  /// Shown as a step on the customer timeline.
  showOnTimeline  Boolean @default(true)

  orders Order[]
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// ───────────────────────── Orders ─────────────────────────

enum OrderType {
  PERSONAL
  B2B
}

enum SubmissionMethod {
  URL
  IMAGE
}

/// One customer request = one parcel: any number of items, all from the same sourcing region.
model Order {
  id                 String           @id @default(cuid())
  number             Int              @unique @default(autoincrement())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  type               OrderType        @default(PERSONAL)
  /// The region every item comes from. Items from different regions cannot share an order (different warehouse).
  regionKey          String?
  /// Order-level note from the customer (delivery, deadline, packaging…). Item details live on OrderItem.
  instructions       String?
  statusKey          String
  status             OrderStatus      @relation(fields: [statusKey], references: [key])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items      OrderItem[]
  media      OrderMedia[]
  quotations Quotation[]
  payments   Payment[]
  charges    AdditionalCharge[]
  tracking   Tracking[]
  events     OrderEvent[]
  notes      InternalNote[]
  notifications Notification[]

  @@index([userId])
  @@index([statusKey])
  @@index([createdAt])
}

/// One product in an order: a store link or a photo request.
model OrderItem {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position          Int              @default(0)
  method            SubmissionMethod
  sourceUrl         String?
  /// Marketplace key if detected or chosen; null = unknown / independent store.
  sourceMarketplace String?
  title             String?
  description       String?
  variant           String?
  sizeColor         String?
  quantity          Int              @default(1)
  note              String?
  /// Staff marked the item as not available at the store: it is left out of the quotation and the parcel.
  unavailable       Boolean          @default(false)
  /// What the customer chose for an out-of-stock item: PENDING (not yet), REMOVED (continue without it), REPLACED (a new item took its place).
  resolution        String?
  /// Price the customer copied from the store page. Informational only — staff verify it; quotations are
  /// always calculated server-side by the pricing engine.
  clientPrice       Decimal?         @db.Decimal(14, 2)
  clientCurrency    String?
  /// Smart preview read server-side from the store page. Informational only.
  previewImageUrl   String?
  previewPrice      Decimal?         @db.Decimal(14, 2)
  previewCurrency   String?
  createdAt         DateTime         @default(now())

  media      OrderMedia[]
  quoteLines QuotationLine[]

  @@index([orderId])
  @@index([sourceMarketplace])
}

enum MediaKind {
  CUSTOMER_REFERENCE
  INSPECTION_PHOTO
  INSPECTION_VIDEO
}

model OrderMedia {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Set for customer photos and screenshots of a specific item; null for order-level media (inspection).
  itemId     String?
  item       OrderItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Opaque key inside the storage adapter (never a public URL).
  storageKey String
  mimeType   String
  sizeBytes  Int
  kind       MediaKind
  createdAt  DateTime  @default(now())

  @@index([orderId])
}

enum QuotationStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum CommissionBasis {
  PRODUCT
  PRODUCT_AND_DOMESTIC
  SUBTOTAL
}

/// Immutable snapshot of a price offer. Every amount is computed on the server.
model Quotation {
  id                       String          @id @default(cuid())
  orderId                  String
  order                    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version                  Int
  status                   QuotationStatus @default(SENT)

  // Order-level inputs. Per-item prices are in QuotationLine.
  /// Total billable weight of the parcel.
  weightKg                 Decimal?        @db.Decimal(8, 2)
  commissionPercent        Decimal         @db.Decimal(5, 2)
  commissionBasis          CommissionBasis
  minCommissionAzn         Decimal         @db.Decimal(10, 2)

  // Computed (AZN). productCostAzn and domesticShippingAzn are the sums of the lines.
  productCostAzn           Decimal         @db.Decimal(12, 2)
  domesticShippingAzn      Decimal         @db.Decimal(12, 2)
  internationalShippingAzn Decimal         @db.Decimal(12, 2)
  serviceFeeAzn            Decimal         @db.Decimal(12, 2)
  sourcingFeeAzn           Decimal         @db.Decimal(12, 2)
  customsChargesAzn        Decimal         @db.Decimal(12, 2)
  otherExpensesAzn         Decimal         @db.Decimal(12, 2)
  /// Optional parcel insurance offered with this quotation (not part of totalAzn). Added as a charge if the customer opts in.
  insuranceAzn             Decimal         @default(0) @db.Decimal(12, 2)
  insured                  Boolean         @default(false)
  totalAzn                 Decimal         @db.Decimal(12, 2)

  noteToCustomer           String?
  expiresAt                DateTime
  createdAt                DateTime        @default(now())
  decidedAt                DateTime?

  payments Payment[]
  lines    QuotationLine[]

  @@unique([orderId, version])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD_TO_CARD
  CASH
  ONLINE
}

/// Payments are recorded and confirmed by staff. No automatic "success" exists
/// until a real payment provider adapter is connected.
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quotationId   String?
  quotation     Quotation?    @relation(fields: [quotationId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("AZN")
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  reference     String?
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?

  @@index([orderId])
}

enum ChargeStatus {
  DUE
  WAIVED
}

/// Charges that appear after the quotation was confirmed (e.g. re-weighing, customs difference).
model AdditionalCharge {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  amountAzn   Decimal      @db.Decimal(12, 2)
  status      ChargeStatus @default(DUE)
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model Tracking {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String
  carrier        String
  status         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Status key at the time of the event (if it was a status change).
  status      String?
  description String
  /// Customer-facing events are shown in the order history; others are internal audit.
  visible     Boolean  @default(true)
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model InternalNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ───────────────────────────────────────── Notifications ─────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  FAILED
  /// Not sent on purpose: channel not configured, customer opted out, no phone… The detail field says why.
  SKIPPED
}

/// Delivery log of customer notifications, shown to staff on the order page.
model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     String
  status    NotificationStatus
  detail    String?
  createdAt DateTime            @default(now())

  @@index([orderId])
}

/// One item's price inside a quotation (source currency + its AZN conversion).
model QuotationLine {
  id                  String    @id @default(cuid())
  quotationId         String
  quotation           Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId              String
  item                OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position            Int       @default(0)
  currency            String
  exchangeRate        Decimal   @db.Decimal(12, 6)
  unitPrice           Decimal   @db.Decimal(12, 2)
  quantity            Int
  domesticShipping    Decimal   @db.Decimal(12, 2)
  /// unitPrice × quantity, source currency
  productCost         Decimal   @db.Decimal(12, 2)
  productCostAzn      Decimal   @db.Decimal(12, 2)
  domesticShippingAzn Decimal   @db.Decimal(12, 2)

  @@index([quotationId])
}

/// One-time password reset link (only the hash of the token is stored). Valid for one hour, usable once.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
